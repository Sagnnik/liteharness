{
  "allow": [
    "read:*",
    "grep:*",
    "glob:*",
    "web_search:*",
    "shell:jobs:*",
    "shell:read:*",
    "shell:run:pwd",
    "shell:run:ls*",
    "shell:run:git status*",
    "shell:run:git diff*",
    "shell:run:git log*",
    "shell:run:git show*"
  ],
  "deny": [
    "shell:run:rm*",
    "shell:run:sudo*",
    "shell:run:curl http*",
    "shell:run:wget *",
    "shell:start:rm*",
    "shell:start:sudo*",
    "shell:start:curl http*",
    "shell:start:wget *"
  ],
  "ask": [
    "*"
  ]
}
