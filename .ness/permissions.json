{
  "allow": [
    "read_file:*",
    "list_files:*",
    "grep:*",
    "glob_files:*",
    "git:action=status*",
    "git:action=diff*",
    "git:action=log*",
    "git:action=show*",
    "web_search:*",
    "bash:pwd",
    "bash:ls*",
    "bash:git status*",
    "bash:git diff*",
    "bash:git log*",
    "bash:git show*"
  ],
  "deny": [
    "bash:rm*",
    "bash:sudo*",
    "bash:curl http*",
    "bash:wget *"
  ],
  "ask": [
    "*"
  ]
}
